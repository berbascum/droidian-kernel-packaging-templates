# Docker stuff by g7
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_VXLAN=y
CONFIG_BRIDGE_VLAN_FILTERING=y
# Additional configs
CONFIG_CGROUPS=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CPU_FREQ=y
CONFIG_CFS_SCHED=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_MEM_RES_CTLR=y
CONFIG_CGROUP_MEM_RES_CTLR_SWAP=y
CONFIG_CGROUP_MEM_RES_CTLR_KMEM=y


#CFS_BANDWIDTH has known incompatibilities with WALT.
#CFS_BANDWIDTH is not essential for Docker, but is recommended,
#Docker daemon will start, but related warnings will shown.
#On some kernel may be marked as incompatible with WALT to avoid enabling both at same time:
#https://android.googlesource.com/kernel/common/+/eb275f4f0dc5902ee81bcdc79a6789e5795b30b3%5E%21/
#But probably WALT cannot be disabled, like the xiaomi vayu case.
#
#Workaround A: Enabling both WALT and CFS_BANDWITH, after reverting the above commit:
# 4.14.190 craches at boot or early minuts
# 4.14.355 with controllers cgroup2 boots fine and seems really stable.
#
CONFIG_CFS_BANDWIDTH=y
CONFIG_SCHED_WALT=y
# CONFIG_RT_GROUP_SCHED is not set
