## DEBUG:FS
CONFIG_DEBUG_FS=y
CONFIG_BLK_DEBUG_FS=y
CONFIG_BT_DEBUGFS=y

## Kernel debug options
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_PSTORE_LAST_KMSG=y

## Debug qcom
## Spectra camera. Requires kerbel version droidian1-sid9+
CONFIG_SPECTRA_CAMERA_DEBUG=y
CONFIG_MSM_DEBUGCC_SM8150=y
CONFIG_DRM_SDE_EVTLOG_DEBUG=y

## IRQ
CONFIG_IRQ_DOMAIN_DEBUG=y
CONFIG_GENERIC_IRQ_DEBUGFS=y

## efi debug
CONFIG_DEBUG_EFI=y
