# Ensure overlay gets built
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# WLAN
CONFIG_QCA_CLD_WLAN=y

# OTG
CONFIG_USB_OTG=y

# CIFS
CONFIG_CIFS=y

## kernel image compression
## For Droidian, in kernel-info.mk:
#KERNEL_BUILD_TARGET = Image.gz
# CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL is not set
CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP=y
CONFIG_KERNEL_GZIP=y
CONFIG_HAVE_KERNEL_GZIP=y
# CONFIG_HAVE_KERNEL_LZ4 is not set
# CONFIG_KERNEL_LZ4 is not set

## Enable modules
CONFIG_MODULES=y
# CONFIG_MODULE_SIG is not set

# dm crypt
CONFIG_DM_CRYPT=y

## block device network mirroring
CONFIG_DRBD=y

## Sensors IIO optimization
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGER=y

## nfc
# CONFIG_NFC is not set
# CONFIG_NFC_DIGITAL is not set
CONFIG_NFC_NQ=y
# CONFIG_NFC_NCI is not set
# CONFIG_NFC_PN533_I2C is not set
# CONFIG_NFC_NXP_NCI is not set
# CONFIG_NFC_NXP_NCI_I2C is not set
# CONFIG_NFC_ST_NCI_I2C is not set
# CONFIG_NFC_HCI is not set

## Wireguard configs
CONFIG_WIREGUARD=y
CONFIG_NET_UDP_TUNNEL=y
CONFIG_CRYPTO_ALGAPI=y
# CONFIG_WIREGUARD_DEBUG is not set

## FW loader from user-space
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y

## Fix clang compilation errors
# CONFIG_MODVERSIONS is not set

## V4L2
CONFIG_V4L2_LOOPBACK=y

## Video
CONFIG_VIDEOMODE_HELPERS=y
CONFIG_DRM_FBDEV_EMULATION=y

## Kernel headers
CONFIG_IKHEADERS=y

## cmdline
CONFIG_CMDLINE=""

## Raw driver
CONFIG_RAW_DRIVER=y
CONFIG_MAX_RAW_DEVS=256

## processor erratum workarounds
## Cortex-A57 erratum
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_834220=y
## Cortex-A76 erratum
CONFIG_ARM64_ERRATUM_1286807=y
CONFIG_ARM64_ERRATUM_1188873=y
## qcomm specific
CONFIG_QCOM_FALKOR_ERRATUM_1003=y
CONFIG_QCOM_FALKOR_ERRATUM_1009=y
CONFIG_QCOM_FALKOR_ERRATUM_1041=y
## common ARM64 workaround for TLBI issues
CONFIG_ARM64_WORKAROUND_REPEAT_TLBI=y
CONFIG_ARM64_ERRATUM_1188220=y
CONFIG_ARM64_ERRATUM_1542419=y
CONFIG_ARM64_WORKAROUND_828220=y
CONFIG_ARM64_WORKAROUND_CACHE_LOWERING=y
CONFIG_ARM64_WORKAROUND_BROKEN_IRQPRIO=y
